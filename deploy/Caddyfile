{$SITE_ADDRESS} {
	encode zstd gzip

	@backend path /api /api/* /mcp /mcp/*
	handle @backend {
		reverse_proxy api:8000
	}

	handle {
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		root * /srv
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
