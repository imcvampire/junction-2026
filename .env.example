# Loaded into every mise task's environment. Copy to .env to override.
API_ENVIRONMENT=development
API_LOG_LEVEL=INFO
# JSON list; only needed when the FE is served from a different origin than /api.
API_CORS_ORIGINS=[]
# VITE_API_URL=https://api.example.com/api

# LLM (OpenAI-compatible API; URL without the trailing /v1)
OPENAI_COMPATIBLE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=kimi-k3-1-pro
