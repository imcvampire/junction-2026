# Loaded into every mise task's environment. Copy to .env to override.
API_ENVIRONMENT=development
API_LOG_LEVEL=INFO
# JSON list; only needed when a browser client calls the API from another origin.
API_CORS_ORIGINS=[]

# LLM (OpenAI-compatible API; URL without the trailing /v1)
OPENAI_COMPATIBLE_URL=https://inference.verda.com
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=kimi-k3-1-pro

# Valio Aimo challenge API (key from the Junction platform; never commit it)
API_VALIO_BASE_URL=https://junction26.valioaimo.fi
API_VALIO_API_KEY=
# API_VALIO_CUSTOMER=junction-demo

# Orders above this total (EUR, excl. VAT) need a human approver
API_APPROVAL_SPEND_THRESHOLD_EUR=500

# Speech-to-text / text-to-speech: any OpenAI-compatible audio API (/v1/audio/*).
# Leave empty to disable the /api/voice endpoints (they answer 503).
API_VOICE_BASE_URL=
API_VOICE_API_KEY=
# API_VOICE_STT_MODEL=whisper-1
# API_VOICE_TTS_MODEL=tts-1
# API_VOICE_TTS_VOICE=alloy
