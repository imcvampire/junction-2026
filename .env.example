# Loaded into every mise task's environment. Copy to .env to override.
API_ENVIRONMENT=development
API_LOG_LEVEL=INFO
# JSON list; only needed when a browser client calls the API from another origin.
API_CORS_ORIGINS=[]

# Valio Aimo challenge API (key from the Junction platform; never commit it)
API_VALIO_BASE_URL=https://junction26.valioaimo.fi
API_VALIO_API_KEY=
# Default upstream customer for new agents (mise run agent:create -- --customer overrides it)
# API_VALIO_CUSTOMER=junction-demo

# Orders above this total (EUR, excl. VAT) need a human approver, unless an agent's mandate sets its own limit
API_APPROVAL_SPEND_THRESHOLD_EUR=500

# Agent quotes: lifetime in seconds, and how many quote calls one agent may make per minute
# API_QUOTE_TTL_S=900
# API_AGENT_QUOTES_PER_MINUTE=30

# Agent key for mise run skill:sandbox (printed once by mise run agent:create; never commit it)
# VALIO_AIMO_AGENT_KEY=

# Hosts and browser origins accepted on /mcp (DNS-rebinding protection). Add the public host when deployed.
# API_MCP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*","[::1]:*"]
# API_MCP_ALLOWED_ORIGINS=["http://127.0.0.1:*","http://localhost:*","http://[::1]:*"]
